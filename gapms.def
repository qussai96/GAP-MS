Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%files
    gapms_v1 /opt/gapms-v1/gapms_v1
    README.md /opt/gapms-v1/README.md
    THIRD_PARTY.md /opt/gapms-v1/THIRD_PARTY.md
    setup.py /opt/gapms-v1/setup.py
    pyproject.toml /opt/gapms-v1/pyproject.toml
    MANIFEST.in /opt/gapms-v1/MANIFEST.in
    LICENSE /opt/gapms-v1/LICENSE

%post
    set -e

    # Nextflow task monitoring requires ps inside the container.
    apt-get update
    apt-get install -y --no-install-recommends procps
    rm -rf /var/lib/apt/lists/*

    micromamba install -y -n base -c conda-forge -c bioconda --override-channels --strict-channel-priority python=3.10 pip perl stringtie transdecoder=5.5.0 samtools gffread gffcompare
    micromamba clean --all --yes
    cd /opt/gapms-v1
    /opt/conda/bin/python -m pip install --no-cache-dir .

%test
    set -e
    # Check the tools used by Nextflow's task metrics wrapper.
    for executable in bash awk date grep ps sed tail tee; do
        command -v "$executable" >/dev/null
    done
    ps -eo pid,ppid,pcpu,pmem,comm >/dev/null
    for executable in stringtie TransDecoder.LongOrfs TransDecoder.Predict; do
        test -x /opt/conda/bin/$executable
    done
    cd /tmp
    /opt/conda/bin/python -c 'from importlib.metadata import version; assert version("gapms")=="1.3.2"; assert version("peplocus")=="0.5.6"'
    /opt/conda/bin/gapms-v1 --help >/dev/null

%runscript
    exec /opt/conda/bin/gapms-v1 "$@"

%labels
    Version 1.3.2
    PepLocusVersion 0.5.6

%environment
    export PATH=/opt/conda/bin:$PATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
