Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%files
    gapms /opt/gapms/gapms
    setup.py /opt/gapms/setup.py
    pyproject.toml /opt/gapms/pyproject.toml
    README.md /opt/gapms/README.md
    requirements.txt /opt/gapms/requirements.txt
    MANIFEST.in /opt/gapms/MANIFEST.in
    LICENSE /opt/gapms/LICENSE
    THIRD_PARTY.md /opt/gapms/THIRD_PARTY.md
    docs /opt/gapms/docs
    xgb_protein_classifier.pkl /opt/gapms/xgb_protein_classifier.pkl

%post
    set -e

    # Install runtime dependencies into the base environment. Micromamba is
    # included in the base image, avoiding a separate bootstrap download.
    micromamba install -y \
        -n base \
        -c conda-forge \
        -c bioconda \
        --override-channels \
        --strict-channel-priority \
        python=3.10 \
        pip \
        perl \
        perl-xml-parser \
        perl-xml-twig \
        gffread \
        gffcompare \
        samtools \
        stringtie \
        transdecoder=5.5.0

    # Install GAP-MS from the copied source tree
    cd /opt/gapms
    /opt/conda/bin/python -m pip install --no-cache-dir --upgrade pip setuptools wheel
    /opt/conda/bin/python -m pip install --no-cache-dir .

    # Clean caches to reduce image size
    micromamba clean --all --yes
    rm -rf /root/.cache/pip

%test
    set -e
    /opt/conda/bin/python -c 'from importlib.metadata import version; import ahocorasick, pysam; from gapms.model_metadata import CodingRuns; assert version("gapms") == "0.2.2"'
    /opt/conda/bin/gapms map --help >/dev/null
    for executable in gffread gffcompare samtools stringtie TransDecoder.LongOrfs TransDecoder.Predict; do
        test -x "/opt/conda/bin/$executable"
    done

%environment
    export PATH=/opt/conda/bin:$PATH
    export CONDA_DEFAULT_ENV=base
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec /opt/conda/bin/gapms "$@"

%labels
    Author Qussai Abbas
    Version 0.2.2
    Description GAP-MS: Gene Model Assessment using Peptides from Mass Spectrometry

%help
    GAP-MS evaluates predicted gene models by integrating peptide evidence
    from mass spectrometry with in-silico gene predictions.

    This image includes the external tools used by the pipeline:
        gffread, gffcompare, samtools, StringTie, and TransDecoder

    Example usage:
        apptainer run gapms.sif -g annotations.gtf -f proteins.fasta -p peptides.txt

    Direct assembly mapping (standard and IGV BED):
        apptainer run gapms.sif map -a assembly.fasta -p peptides.txt -g annotations.gtf -o mapped

    With BAM input:
        apptainer exec gapms.sif gapms -b rnaseq.bam -a assembly.fasta -p peptides.txt

    With both prediction + BAM branches and reference comparison:
        apptainer exec gapms.sif gapms \
            -g predictions.gtf -b rnaseq.bam -a assembly.fasta -p peptides.txt \
            -rg reference.gtf -rf reference.faa

    For more information:
        apptainer exec gapms.sif gapms --help
